{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "conjunto": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "versaoDefinicao": {
      "type": "integer",
      "minimum": 1
    },
    "tipo": {
      "enum": [
        "ORGANIZADO",
        "DERIVADO"
      ]
    },
    "edicaoPor": {
      "enum": [
        "ARQUIVO",
        "LISTA"
      ]
    },
    "fontes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "funcao": {
          "type": "string",
          "minLength": 1
        },
        "arquivos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "membros": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "formatoMembro": {
          "enum": ["csv", "txt", "tsv", "xlsx", "xls", "dbf", "dbc"]
        },
        "abas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "encoding": {
          "type": "string",
          "minLength": 1
        },
        "delimiter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        }
      },
      "required": [
        "funcao",
        "arquivos"
      ]
    },
    "cabecalho": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linha": {
          "type": "integer",
          "minimum": 1
        },
        "contemUmDe": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semCabecalho": {
          "const": true
        }
      },
      "required": []
    },
    "colunas": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "derivadas": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "filtroLinhas": {
      "type": "string",
      "minLength": 1
    },
    "saida": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "chave": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "municipioCodigo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coluna": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "tipo": {
          "enum": [
            "IBGE7",
            "IBGE6",
            "TSE",
            "RFB",
            "NOME_UF"
          ]
        }
      },
      "required": [
        "coluna",
        "tipo"
      ]
    },
    "referencias": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "validacoes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linhasMinPorAba": {
          "type": "integer",
          "minimum": 0
        },
        "chaveUnica": {
          "type": "boolean"
        },
        "colunasPresentes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "obrigatorias": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "nulosMaxPct": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "semCorrespondenciaMaxPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": []
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "consulta": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "conjunto",
    "nome",
    "versaoDefinicao",
    "tipo",
    "edicaoPor",
    "saida",
    "chave",
    "validacoes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "ORGANIZADO"
          }
        }
      },
      "then": {
        "required": [
          "fontes",
          "cabecalho",
          "colunas",
          "filtroLinhas"
        ],
        "properties": {
          "cabecalho": {
            "oneOf": [
              {
                "required": [
                  "linha"
                ],
                "not": {
                  "anyOf": [
                    { "required": ["contemUmDe"] },
                    { "required": ["semCabecalho"] }
                  ]
                }
              },
              {
                "required": [
                  "contemUmDe"
                ],
                "not": {
                  "anyOf": [
                    { "required": ["linha"] },
                    { "required": ["semCabecalho"] }
                  ]
                }
              },
              {
                "required": [
                  "semCabecalho"
                ],
                "not": {
                  "anyOf": [
                    { "required": ["linha"] },
                    { "required": ["contemUmDe"] }
                  ]
                }
              }
            ]
          },
          "colunas": {
            "minProperties": 1
          }
        }
      },
      "else": {
        "required": [
          "base",
          "consulta"
        ]
      }
    }
  ]
}
